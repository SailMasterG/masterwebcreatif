---
// Divisor de sección "firma" — reinterpreta las dos V entrelazadas
// del logo como una línea continua. Se usa con moderación (1-2 veces
// por página), nunca como decoración repetida sin sentido.
interface Props {
  flip?: boolean;
}
const { flip = false } = Astro.props;
---
<div class={`wave-divider ${flip ? 'wave-divider--flip' : ''}`} aria-hidden="true">
  <svg viewBox="0 0 400 40" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
    <path
      d="M0,20 L50,35 L100,5 L150,35 L200,5 L250,35 L300,5 L350,35 L400,20"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    />
  </svg>
</div>

<style>
  .wave-divider {
    width: 100%;
    height: 24px;
    color: var(--color-turquoise-light);
    opacity: 0.6;
  }
  .wave-divider--flip {
    transform: scaleY(-1);
  }
  .wave-divider svg {
    width: 100%;
    height: 100%;
    display: block;
  }
</style>
