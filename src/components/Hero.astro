---
import WaveDivider from './WaveDivider.astro';

interface Props {
  eyebrow: string;
  title: string;
  subtitle: string;
  ctaPrimaryLabel: string;
  ctaPrimaryHref: string;
  ctaSecondaryLabel: string;
  ctaSecondaryHref: string;
}
const { eyebrow, title, subtitle, ctaPrimaryLabel, ctaPrimaryHref, ctaSecondaryLabel, ctaSecondaryHref } = Astro.props;
---
<section class="hero">
  <div class="container hero__inner">
    <p class="eyebrow">{eyebrow}</p>
    <h1>{title}</h1>
    <p class="hero__subtitle">{subtitle}</p>
    <div class="hero__actions">
      <a href={ctaPrimaryHref} class="hero__btn hero__btn--primary">{ctaPrimaryLabel}</a>
      <a href={ctaSecondaryHref} class="hero__btn hero__btn--secondary" target="_blank" rel="noopener noreferrer">{ctaSecondaryLabel}</a>
    </div>
  </div>
  <WaveDivider />
</section>

<style>
  .hero {
    background: linear-gradient(180deg, var(--color-bg-alt) 0%, var(--color-bg) 100%);
    padding-block: var(--space-2xl) var(--space-lg);
  }
  .hero__inner {
    max-width: var(--max-width-narrow);
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-sm);
  }
  .hero h1 {
    font-size: var(--text-4xl);
    margin-top: 0.4rem;
    letter-spacing: -0.02em;
  }
  @media (max-width: 640px) {
    .hero h1 { font-size: var(--text-3xl); }
  }
  .hero__subtitle {
    font-size: var(--text-lg);
    max-width: 46ch;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-sm);
    margin-top: var(--space-sm);
  }
  .hero__btn {
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius-sm);
    font-weight: 600;
  }
  .hero__btn--primary {
    background: var(--color-navy);
    color: var(--color-text-on-dark);
  }
  .hero__btn--primary:hover { background: var(--color-navy-light); }
  .hero__btn--secondary {
    background: var(--color-surface);
    color: var(--color-navy);
    border: 1.5px solid var(--color-bg-alt);
  }
  .hero__btn--secondary:hover { border-color: var(--color-turquoise); }
</style>
